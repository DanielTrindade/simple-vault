export global Theme {
    out property <color> bg: #0d0f13;
    out property <color> sidebar: #111318;
    out property <color> surface: #15181e;
    out property <color> surface-2: #1b1f26;
    out property <color> surface-3: #232831;
    out property <color> input: #101317;
    out property <color> border: #232830;
    out property <color> border-strong: #343b47;
    out property <color> overlay: #05060ac0;

    out property <color> text: #e9ebf0;
    out property <color> text-2: #a3aab6;
    out property <color> text-3: #6c7480;

    out property <color> accent: #7c8cff;
    out property <color> accent-hover: #929fff;
    out property <color> accent-soft: #7c8cff22;
    out property <color> accent-fg: #0b0d14;

    out property <color> success: #3ecf8e;
    out property <color> success-soft: #3ecf8e1f;
    out property <color> warning: #f2b14c;
    out property <color> warning-soft: #f2b14c1f;
    out property <color> danger: #f0646a;
    out property <color> danger-soft: #f0646a1f;

    out property <length> radius-sm: 6px;
    out property <length> radius: 8px;
    out property <length> radius-lg: 12px;

    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12px;
    out property <length> fs: 13px;
    out property <length> fs-md: 14px;
    out property <length> fs-lg: 16px;
    out property <length> fs-xl: 20px;
    out property <length> fs-2xl: 26px;

    out property <string> font: "Segoe UI";
    out property <string> mono: "Consolas";

    out property <duration> fast: 120ms;
    out property <duration> normal: 180ms;
}

